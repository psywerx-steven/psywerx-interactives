{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psywerx.org/schemas/proposed/intervention-v1.schema.json",
  "title": "PSYWERX governed-design Intervention V1 draft",
  "description": "Non-production schema draft for Intervention identity and package composition. Scientific target/effect claims belong to InterventionEffect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "canonicalName",
    "aliases",
    "interventionKind",
    "category",
    "description",
    "componentInterventionIds",
    "identitySourceIds",
    "externalCrosswalks",
    "governance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "GOVERNED-DESIGN-1.0-DRAFT"
    },
    "id": {
      "type": "string",
      "pattern": "^INT-[0-9]{5}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "canonicalName": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interventionKind": {
      "enum": [
        "ATOMIC",
        "PACKAGE"
      ]
    },
    "category": {
      "enum": [
        "COMMUNICATION_OR_INFORMATION",
        "TRAINING_OR_SKILL",
        "ENVIRONMENTAL_OR_CHOICE_ARCHITECTURE",
        "POLICY_RULE_OR_STANDARD",
        "INCENTIVE_OR_RESOURCE",
        "CONSTRAINT_OR_ENFORCEMENT",
        "TECHNOLOGY_OR_CONFIGURATION",
        "SERVICE_OR_SUPPORT",
        "BIOLOGICAL_OR_CLINICAL",
        "OTHER_SPECIFIED"
      ]
    },
    "categorySpecification": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "componentInterventionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^INT-[0-9]{5}$"
      }
    },
    "packageSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentRoles",
        "deliveryRelationship"
      ],
      "properties": {
        "componentRoles": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object"
          }
        },
        "deliveryRelationship": {
          "enum": [
            "ORDERED",
            "CONCURRENT",
            "MIXED",
            "NOT_SPECIFIED"
          ]
        },
        "interactionNotes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generalImplementationNotes": {
      "type": "string",
      "minLength": 1
    },
    "identitySourceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "externalCrosswalks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taxonomy",
          "externalId",
          "mappingType",
          "sourceId"
        ],
        "properties": {
          "taxonomy": {
            "type": "string",
            "minLength": 1
          },
          "externalId": {
            "type": "string",
            "minLength": 1
          },
          "mappingType": {
            "enum": [
              "EXACT",
              "NARROWER",
              "BROADER",
              "OVERLAPPING"
            ]
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "governance": {
      "$ref": "relationship-v1.schema.json#/$defs/governance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "interventionKind": {
            "const": "PACKAGE"
          }
        }
      },
      "then": {
        "required": [
          "packageSpecification"
        ],
        "properties": {
          "componentInterventionIds": {
            "minItems": 2
          }
        }
      },
      "else": {
        "properties": {
          "componentInterventionIds": {
            "maxItems": 0
          }
        },
        "not": {
          "required": [
            "packageSpecification"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "OTHER_SPECIFIED"
          }
        }
      },
      "then": {
        "required": [
          "categorySpecification"
        ]
      }
    }
  ]
}
