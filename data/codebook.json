      "id": "CB-DRV-TIME-SCALE",
      "sheet": "Drivers",
      "field": "Time Scale of Change",
      "definition": "Typical elapsed time over which the driver state meaningfully changes.",
      "allowedValuesOrFormat": "Seconds–Minutes; Minutes–Hours; Hours–Days; Days–Weeks; Weeks–Months; Months–Years; Years–Generations; Mixed / Context-dependent; Stable / Not applicable; semicolon-separated canonical combinations",
      "allowedValues": [
        "Seconds–Minutes",
        "Minutes–Hours",
        "Hours–Days",
        "Days–Weeks",
        "Weeks–Months",
        "Months–Years",
        "Years–Generations",
        "Mixed / Context-dependent",
        "Stable / Not applicable"
      ],
      "required": true,
      "guidance": "Select one or more canonical bands. Broad contiguous ranges must list every spanned band, separated by semicolons, shortest to longest. Use canonical capitalization and en dashes. Mixed / Context-dependent and Stable / Not applicable are each exclusive. Chronicity and persistence do not themselves define change speed. Use Time Scale Qualifier to preserve narrative nuance.",
      "source": {
        "sheet": "Codebook",
        "row": 28
      }
    },
    {
      "id": "CB-DRV-TIME-SCALE-QUALIFIER",
      "sheet": "Drivers",
