{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psywerx.org/schemas/cross-level-exposure-binding.schema.json",
  "title": "CrossLevelExposureBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bindingId", "bindingVersion", "relationshipId", "relationshipRevisionOrHash", "sourceEntityId", "sourceLevel", "targetEntityId", "targetLevel", "mappingId", "mappingVersion", "claimSpecificQualifiers", "intermediateEntityIds", "happeningTypeIds", "networkStateReferences", "implementationRequirement", "membershipRule", "eligibilityRule", "assignmentRule", "actualExposureRule", "perceptionRequired", "perceptionEntityId", "exposureWindow", "coverageRule", "temporalAlignment", "evidenceReferences", "scope", "provenance", "shadowEligibilityOnly", "feedsGraphConstruction", "feedsSimulation", "executionAuthorized"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "bindingId": {"type": "string", "pattern": "^XLEB-V1-[A-Z0-9-]+$"},
    "bindingVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "relationshipId": {"type": "string", "minLength": 1},
    "relationshipRevisionOrHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceEntityId": {"type": "string", "minLength": 1},
    "sourceLevel": {"$ref": "cross-level-exposure-mapping.schema.json#/$defs/level"},
    "targetEntityId": {"type": "string", "minLength": 1},
    "targetLevel": {"$ref": "cross-level-exposure-mapping.schema.json#/$defs/level"},
    "mappingId": {"type": "string", "pattern": "^XLEM-V1-[A-Z0-9-]+$"},
    "mappingVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "claimSpecificQualifiers": {"type": "array", "items": {"type": "string"}},
    "intermediateEntityIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "happeningTypeIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "networkStateReferences": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "implementationRequirement": {"$ref": "#/$defs/requirement"},
    "membershipRule": {"type": "string"},
    "eligibilityRule": {"type": "string"},
    "assignmentRule": {"type": "string"},
    "actualExposureRule": {"$ref": "#/$defs/requirement"},
    "perceptionRequired": {"type": "boolean"},
    "perceptionEntityId": {"type": ["string", "null"]},
    "exposureWindow": {"type": "string", "minLength": 1},
    "coverageRule": {"type": "string", "minLength": 1},
    "temporalAlignment": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "evidenceReferences": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "scope": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "additionalProperties": true, "required": ["architectureDecisionId"], "properties": {"architectureDecisionId": {"const": "GOV-CROSS-LEVEL-IMPLEMENTATION-001-2026-09-26"}}},
    "shadowEligibilityOnly": {"const": true},
    "feedsGraphConstruction": {"const": false},
    "feedsSimulation": {"const": false},
    "executionAuthorized": {"const": false}
  },
  "$defs": {"requirement": {"type": "object", "additionalProperties": false, "required": ["required", "definition"], "properties": {"required": {"type": "boolean"}, "definition": {"type": "string", "minLength": 1}}}}
}
