{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psywerx.org/schemas/relationship-intervention/v1/intervention-v1.schema.json",
  "title": "PSYWERX Intervention V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "canonicalName", "aliases", "interventionKind", "category", "categorySpecification", "description", "componentInterventionIds", "identitySourceIds", "externalCrosswalks", "governance"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "canonicalName": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "interventionKind": {"enum": ["ATOMIC", "PACKAGE"]},
    "category": {"enum": ["COMMUNICATION_OR_INFORMATION", "TRAINING_OR_SKILL", "ENVIRONMENTAL_OR_CHOICE_ARCHITECTURE", "POLICY_RULE_OR_STANDARD", "INCENTIVE_OR_RESOURCE", "CONSTRAINT_OR_ENFORCEMENT", "TECHNOLOGY_OR_CONFIGURATION", "SERVICE_OR_SUPPORT", "BIOLOGICAL_OR_CLINICAL", "OTHER_SPECIFIED"]},
    "categorySpecification": {"type": ["string", "null"], "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "componentInterventionIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "identitySourceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "externalCrosswalks": {"type": "array", "items": {"type": "object"}},
    "governance": {"$ref": "governance-v1.schema.json"}
  },
  "allOf": [
    {
      "if": {"properties": {"interventionKind": {"const": "ATOMIC"}}},
      "then": {"properties": {"componentInterventionIds": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"interventionKind": {"const": "PACKAGE"}}},
      "then": {"properties": {"componentInterventionIds": {"minItems": 2}}}
    },
    {
      "if": {"properties": {"category": {"const": "OTHER_SPECIFIED"}}},
      "then": {"properties": {"categorySpecification": {"type": "string"}}},
      "else": {"properties": {"categorySpecification": {"type": "null"}}}
    }
  ]
}
