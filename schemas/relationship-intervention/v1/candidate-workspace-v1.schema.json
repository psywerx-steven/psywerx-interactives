{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psywerx.org/schemas/relationship-intervention/v1/candidate-workspace-v1.schema.json",
  "title": "PSYWERX Relationship + Intervention V1 Candidate Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceStatus", "productionGraphEligible", "relationships", "evidenceAssessments", "causalPathways", "interventions", "interventionEffects"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "workspaceStatus": {"const": "NON_GOVERNED_CANDIDATE_WORKSPACE"},
    "productionGraphEligible": {"const": false},
    "relationships": {"type": "array", "items": {"$ref": "relationship-v1.schema.json"}},
    "evidenceAssessments": {"type": "array", "items": {"$ref": "evidence-assessment-v1.schema.json"}},
    "causalPathways": {"type": "array", "items": {"$ref": "causal-pathway-v1.schema.json"}},
    "interventions": {"type": "array", "items": {"$ref": "intervention-v1.schema.json"}},
    "interventionEffects": {"type": "array", "items": {"$ref": "intervention-effect-v1.schema.json"}}
  }
}
