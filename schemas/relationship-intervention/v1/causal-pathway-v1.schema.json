{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psywerx.org/schemas/relationship-intervention/v1/causal-pathway-v1.schema.json",
  "title": "PSYWERX CausalPathway V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "revision", "startEntityId", "endEntityId",
    "orderedRelationshipIds", "intermediateEntities", "mediationClassification",
    "alignedScope", "temporalOrderRationale", "evidenceAssessmentIds",
    "sourceIds", "duplicateCountingControl", "contributesCausalEdge", "governance"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "startEntityId": {"type": "string", "minLength": 1},
    "endEntityId": {"type": "string", "minLength": 1},
    "orderedRelationshipIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "intermediateEntities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entityId", "role"],
        "properties": {
          "entityId": {"type": "string", "minLength": 1},
          "role": {"enum": ["MEDIATOR", "MECHANISTIC_INTERMEDIATE"]}
        }
      }
    },
    "mediationClassification": {"enum": ["PARTIAL", "FULL", "UNDETERMINED"]},
    "alignedScope": {
      "type": "object", "additionalProperties": false,
      "required": ["analyticUnit", "populationOrSystem", "context"],
      "properties": {
        "analyticUnit": {"type": "string", "minLength": 1},
        "populationOrSystem": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1}
      }
    },
    "temporalOrderRationale": {"type": "string", "minLength": 1},
    "evidenceAssessmentIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sourceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "duplicateCountingControl": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "totalEffectRelationshipId", "rationale"],
      "properties": {
        "mode": {"enum": ["PATHWAY_ONLY", "TOTAL_EFFECT_ONLY", "RECONCILED"]},
        "totalEffectRelationshipId": {"type": ["string", "null"], "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"mode": {"const": "RECONCILED"}}},
        "then": {"properties": {"totalEffectRelationshipId": {"type": "string"}}},
        "else": {"properties": {"totalEffectRelationshipId": {"type": "null"}}}
      }]
    },
    "contributesCausalEdge": {"const": false},
    "governance": {"$ref": "governance-v1.schema.json"}
  }
}
