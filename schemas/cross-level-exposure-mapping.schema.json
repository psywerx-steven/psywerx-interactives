{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psywerx.org/schemas/cross-level-exposure-mapping.schema.json",
  "title": "CrossLevelExposureMapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mappingId", "mappingVersion", "objectKind", "sourceLevel", "targetLevel", "routeType", "routeStages", "exposureDefinition", "exposureUnit", "temporalOrder", "membershipSemantics", "eligibilitySemantics", "implementationSemantics", "assignmentSemantics", "actualExposureSemantics", "perceivedExposureSemantics", "coverageSemantics", "partialCoverageAllowed", "ambientContextAllowed", "networkStateRequirements", "intermediateReferenceRules", "evidenceBindingRules", "scopeLimitations", "causalEvidence", "executionAuthority", "hasWeight", "hasLifecycle", "hasPropagationState", "provenance"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "mappingId": {"type": "string", "pattern": "^XLEM-V1-[A-Z0-9-]+$"},
    "mappingVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "objectKind": {"const": "SCIENTIFIC_ROUTING_ELIGIBILITY_CONTRACT"},
    "sourceLevel": {"$ref": "#/$defs/level"},
    "targetLevel": {"$ref": "#/$defs/level"},
    "routeType": {"enum": ["MEMBERSHIP", "ELIGIBILITY", "ASSIGNMENT", "IMPLEMENTATION", "ENFORCEMENT", "CONTACT", "INFORMATION_EXPOSURE", "RESOURCE_ACCESS", "SERVICE_DELIVERY", "SOCIAL_INTERACTION", "NETWORK_POSITION", "AMBIENT_CONTEXT", "OBSERVATION", "MONITORING", "SANCTION_EXPOSURE", "INCENTIVE_EXPOSURE"]},
    "routeStages": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "exposureDefinition": {"type": "string", "minLength": 1},
    "exposureUnit": {"type": "string", "minLength": 1},
    "temporalOrder": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "membershipSemantics": {"type": "string", "minLength": 1},
    "eligibilitySemantics": {"type": "string", "minLength": 1},
    "implementationSemantics": {"type": "string", "minLength": 1},
    "assignmentSemantics": {"type": "string", "minLength": 1},
    "actualExposureSemantics": {"type": "string", "minLength": 1},
    "perceivedExposureSemantics": {"type": "string", "minLength": 1},
    "coverageSemantics": {"type": "string", "minLength": 1},
    "partialCoverageAllowed": {"type": "boolean"},
    "ambientContextAllowed": {"type": "boolean"},
    "networkStateRequirements": {"type": "object", "additionalProperties": false, "required": ["required", "description"], "properties": {"required": {"type": "boolean"}, "description": {"type": "string"}}},
    "intermediateReferenceRules": {"type": "array", "items": {"type": "string"}},
    "evidenceBindingRules": {"type": "array", "items": {"type": "string"}},
    "scopeLimitations": {"type": "array", "items": {"type": "string"}},
    "causalEvidence": {"const": false},
    "executionAuthority": {"const": false},
    "hasWeight": {"const": false},
    "hasLifecycle": {"const": false},
    "hasPropagationState": {"const": false},
    "provenance": {"type": "object", "additionalProperties": true, "required": ["architectureDecisionId"], "properties": {"architectureDecisionId": {"const": "GOV-CROSS-LEVEL-IMPLEMENTATION-001-2026-09-26"}}}
  },
  "$defs": {"level": {"enum": ["PERSON", "DYAD", "EGO_NETWORK", "GROUP", "ORGANIZATION", "INSTITUTION", "COMMUNITY", "POPULATION", "NETWORK", "JURISDICTION", "MARKET", "STATE_SYSTEM"]}}
}
