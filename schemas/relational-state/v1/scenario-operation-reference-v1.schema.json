{
  "$id": "https://psywerx.org/schemas/relational-state/v1/scenario-operation-reference-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "automaticExecution": {
      "const": false
    },
    "deltaRef": {
      "additionalProperties": false,
      "properties": {
        "contentHash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision",
        "contentHash"
      ],
      "type": "object"
    },
    "empiricalConsequenceClaim": {
      "const": false
    },
    "happeningTypeRef": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "contentHash": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "id": {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "revision",
            "contentHash"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "objectKind": {
      "const": "SCENARIO_OPERATION_REFERENCE"
    },
    "occurrenceRef": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "contentHash": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "id": {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "revision",
            "contentHash"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "relation": {
      "const": "REFERENCES_STIPULATED_OPERATION_NOT_EFFECT"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "objectKind",
    "occurrenceRef",
    "happeningTypeRef",
    "deltaRef",
    "relation",
    "automaticExecution",
    "empiricalConsequenceClaim"
  ],
  "title": "PSYWERX scenario-operation-reference V1",
  "type": "object"
}
