              "type": "object"
            },
            "subjectNodeIds": {
              "items": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
                "type": "string"
              },
              "minItems": 0,
              "type": "array",
              "uniqueItems": true
            },
            "values": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "nodeId": {
                    "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
                    "type": "string"
                  },
                  "value": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "nodeId",
                  "value"
                ],
                "type": "object"
              },
              "minItems": 0,
              "type": "array",
              "uniqueItems": false
