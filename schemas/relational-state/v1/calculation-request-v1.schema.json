              "required": [
                "id",
                "revision",
                "includedNodeIds",
                "includedPopulationRule",
                "excludedPopulationRule",
                "unknownPopulationRule"
              ],
              "type": "object"
            },
            "completeness": {
              "const": "COMPLETE_ALIGNED"
