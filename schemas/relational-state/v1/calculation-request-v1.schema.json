{
  "$id": "https://psywerx.org/schemas/relational-state/v1/calculation-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindingRef": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "contentHash": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "id": {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "revision",
            "contentHash"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "boundary": {
      "additionalProperties": false,
      "properties": {
        "excludedPopulationRule": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
          "type": "string"
        },
        "includedNodeIds": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "includedPopulationRule": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "unknownPopulationRule": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "includedNodeIds",
        "includedPopulationRule",
        "excludedPopulationRule",
        "unknownPopulationRule"
      ],
      "type": "object"
    },
    "collection": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "boundary": {
              "additionalProperties": false,
              "properties": {
                "excludedPopulationRule": {
                  "minLength": 1,
                  "type": "string"
                },
                "id": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
                  "type": "string"
                },
                "includedNodeIds": {
                  "items": {
                    "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
