  "required": [
    "schemaVersion",
    "objectKind",
    "id",
    "recordClass",
    "stateRef",
    "boundary",
    "window",
    "targetRds",
    "metric",
    "bindingRef",
    "collection",
    "externalBenchmark",
    "useMode",
    "contributionIdentity",
    "propagationRoutes"
  ],
  "title": "PSYWERX calculation-request V1",
  "type": "object"
}
