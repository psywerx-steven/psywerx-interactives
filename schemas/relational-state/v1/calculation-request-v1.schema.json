                  "type": "array",
                  "uniqueItems": true
                },
                "includedPopulationRule": {
                  "minLength": 1,
                  "type": "string"
                },
                "revision": {
                  "minimum": 1,
                  "type": "integer"
                },
                "unknownPopulationRule": {
                  "minLength": 1,
                  "type": "string"
