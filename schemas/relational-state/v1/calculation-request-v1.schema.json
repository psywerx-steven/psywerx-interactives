                "contentHash": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "id": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
                  "type": "string"
                },
                "revision": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "revision",
