{
  "$id": "https://psywerx.org/schemas/relational-state/v1/calculation-receipt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindingRef": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "contentHash": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "id": {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "revision",
            "contentHash"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "causalContribution": {
      "const": false
    },
    "contributionIdentity": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
      "type": "string"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": false
    },
    "modelEligibility": {
      "const": false
    },
    "objectKind": {
      "const": "CALCULATION_RECEIPT"
    },
    "practitionerActionEligibility": {
      "const": false
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "receiptHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "requestHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "requestId": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "scientificUseEligible": {
      "const": false
    },
    "stateRef": {
      "additionalProperties": false,
      "properties": {
        "contentHash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision",
        "contentHash"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "CALCULATED_SYNTHETIC",
        "UNSUPPORTED_OR_INCOMPLETE",
        "NOT_AUTHORIZED"
      ]
    },
    "targetRds": {
      "additionalProperties": false,
      "properties": {
        "definitionHash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "definitionVersion": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "definitionVersion",
        "definitionHash"
      ],
      "type": "object"
    },
    "value": {
      "anyOf": [
        {
          "type": [
            "number",
            "object"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "objectKind",
    "requestId",
    "requestHash",
    "stateRef",
    "bindingRef",
    "targetRds",
    "status",
    "value",
    "reason",
    "limitations",
    "contributionIdentity",
    "causalContribution",
    "scientificUseEligible",
    "modelEligibility",
    "practitionerActionEligibility",
    "receiptHash"
  ],
  "title": "PSYWERX calculation-receipt V1",
  "type": "object"
}
