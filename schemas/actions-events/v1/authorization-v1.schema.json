{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psywerx.org/schemas/actions-events/v1/authorization-v1.schema.json",
  "title": "PSYWERX Actions & Events authorization V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionId",
    "decisionRecord",
    "actorClass",
    "effectiveDate",
    "authorizedObjects",
    "recordClass"
  ],
  "properties": {
    "decisionId": {
      "type": "string",
      "minLength": 1
    },
    "decisionRecord": {
      "type": "string",
      "minLength": 1
    },
    "actorClass": {
      "const": "AUTHORIZED_HUMAN_GOVERNOR"
    },
    "effectiveDate": {
      "type": "string",
      "format": "date"
    },
    "authorizedObjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "recordHash"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "recordHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "recordClass": {
      "enum": [
        "SCIENTIFIC_RECORD",
        "SYNTHETIC / NON_PRODUCTION"
      ]
    }
  }
}
